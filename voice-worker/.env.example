PORT=8787
HOST=0.0.0.0
TOKEN=change-me
LOG_LEVEL=info
DEFAULT_PROVIDER=narrator
DEFAULT_LANGUAGE=en
VOICE_CACHE_DIR=.cache/audio
VOICE_OUTPUT_DIR=../voice-output
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PIPER_BIN=
PIPER_MODEL=
PIPER_VOICE=en_US-lessac-medium
NARRATOR_VOICE=novelverse-narrator
# Fish Speech is primary; Kokoro and Piper are automatic local fallbacks.
# Optional overrides. Standard loopback ports are detected automatically.
FISH_SPEECH_URL=
KOKORO_URL=
LOCAL_TTS_PROBE_TIMEOUT_MS=350
GENERIC_TTS_URL=
GENERIC_TTS_TOKEN=
GENERIC_TTS_LANGUAGES=en
