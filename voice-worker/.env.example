PORT=8787
HOST=0.0.0.0
TOKEN=change-me
LOG_LEVEL=info
DEFAULT_PROVIDER=narrator
DEFAULT_LANGUAGE=en
VOICE_CACHE_DIR=.cache/audio
VOICE_OUTPUT_DIR=../voice-output
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PIPER_BIN=
PIPER_MODEL=
PIPER_VOICE=en_US-lessac-medium
NARRATOR_VOICE=novelverse-narrator
# Fish Speech is primary; Kokoro and Piper are automatic local fallbacks.
FISH_SPEECH_URL=http://127.0.0.1:8080/v1/tts
KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
GENERIC_TTS_URL=
GENERIC_TTS_TOKEN=
GENERIC_TTS_LANGUAGES=en
