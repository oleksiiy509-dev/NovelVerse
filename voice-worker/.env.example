PORT=8787
HOST=0.0.0.0
TOKEN=change-me
LOG_LEVEL=info
DEFAULT_PROVIDER=narrator
DEFAULT_LANGUAGE=en
VOICE_CACHE_DIR=.cache/audio
VOICE_OUTPUT_DIR=../voice-output
# Durable object-storage mount. WAV and MP3 artifacts are copied here after rendering.
AUDIO_STORAGE_DIR=../voice-storage
# API returning chapter JSON at <url>/<chapterId>; required for GET /audio to start unseen chapters.
CHAPTER_SOURCE_URL=
CHAPTER_SOURCE_TOKEN=
PUBLIC_AUDIO_BASE_URL=
# Cloud Core: R2 holds audio objects; Supabase holds render metadata only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=novelverse-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PIPER_BIN=
PIPER_MODEL=
PIPER_VOICE=en_US-lessac-medium
NARRATOR_VOICE=novelverse-narrator
# Fish Speech is primary; Kokoro and Piper are automatic local fallbacks.
FISH_SPEECH_URL=http://127.0.0.1:8080/v1/tts
# Fish Speech has no /health route; GET on its POST-only TTS route returns 405 when ready.
FISH_SPEECH_HEALTH_URL=http://127.0.0.1:8080/v1/tts
# Optional: only set this after registering a matching reference in Fish Speech.
FISH_SPEECH_REFERENCE_ID=
KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
KOKORO_HEALTH_URL=http://127.0.0.1:8880/health
GENERIC_TTS_URL=
GENERIC_TTS_HEALTH_URL=
GENERIC_TTS_TOKEN=
GENERIC_TTS_LANGUAGES=en
