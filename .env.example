# Supabase public frontend configuration (required on Vercel)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only TTS configuration. Piper is the default provider.
# Never prefix provider keys with VITE_ and never commit real secret values.
# Set these as Supabase Edge Function secrets in production. The URL must be the
# public HTTPS origin of the separately deployed voice-worker, without /health or
# /synthesize. It must not be 127.0.0.1 unless the worker shares the function host.
# NOVELVERSE_TTS_PROVIDER=piper
# NOVELVERSE_PIPER_URL=https://voice-worker.example.com
# NOVELVERSE_PIPER_TOKEN=use-the-same-value-as-voice-worker-TOKEN
# Optional runtime overrides.
# NOVELVERSE_TTS_MAX_CHARS_PER_JOB=120000
# NOVELVERSE_TTS_MAX_SEGMENTS_PER_JOB=600
# NOVELVERSE_TTS_DAILY_USER_LIMIT=10
# NOVELVERSE_TTS_PREVIEW_MAX_CHARS=250
# NOVELVERSE_TTS_TIMEOUT_MS=45000
# NOVELVERSE_TTS_RETRY_COUNT=2
# NOVELVERSE_AUDIO_MERGE_STRATEGY=segment-manifest
