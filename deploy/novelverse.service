[Unit]
Description=NovelVerse production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/novelverse
ExecStart=/opt/novelverse/scripts/start-production.sh
ExecStop=/opt/novelverse/scripts/stop-production.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
