# Copy to .env.production, chmod 600, and replace every value.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VOICE_WORKER_TOKEN=change-me-at-least-32-random-characters
TOKEN=change-me-at-least-32-random-characters
DEFAULT_PROVIDER=fish-speech
FISH_SPEECH_URL=http://fish-speech:8080
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=novelverse-audio
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://audio.example.com
R2_KEY_PREFIX=production
R2_MULTIPART_THRESHOLD_BYTES=52428800
R2_MULTIPART_PART_SIZE_BYTES=10485760
R2_RETRY_ATTEMPTS=4
UPLOAD_JOB_ATTEMPTS=3
LOG_LEVEL=info
LOG_FORMAT=json
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
VOICE_BIND_ADDRESS=127.0.0.1
VOICE_PORT=8787
